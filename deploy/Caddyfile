# Roteador interno de produção. Fica atrás do Cloudflare Tunnel: o HTTPS é
# feito pela Cloudflare (RNF11) e o túnel entrega aqui, em HTTP, as requisições
# de todos os endereços do domínio. O Caddy separa por host, aplica os
# cabeçalhos de segurança e o limite de upload. Não publica nenhuma porta.

{
	# A requisição chega pelo container do túnel (rede interna do Docker):
	# confiar nele mantém o IP real do usuário no X-Forwarded-For.
	servers {
		trusted_proxies static private_ranges
	}
}

(seguranca) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Frontend (Next.js)
http://app.{$DOMINIO} {
	import seguranca
	reverse_proxy frontend:3000
}

# API (FastAPI)
http://api.{$DOMINIO} {
	import seguranca
	# Barra uploads muito acima do limite da API (UPLOAD_MAX_MB) antes de
	# chegarem ao container.
	request_body {
		max_size {$LIMITE_UPLOAD_PROXY}
	}
	reverse_proxy api:8000
}

# Domínio raiz e www levam para o frontend.
http://{$DOMINIO}, http://www.{$DOMINIO} {
	redir https://app.{$DOMINIO}{uri} permanent
}
