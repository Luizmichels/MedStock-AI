# .env de PRODUÇÃO. No servidor, copie para a raiz do repositório:
#   cp deploy/env.producao.example .env
# e troque todos os valores. Nunca commite o .env.
#
# AMBIENTE, DATABASE_URL e FRONTEND_URL são definidos pelo
# docker-compose.prod.yml; não precisam estar aqui.

# Domínio registrado, sem "app." nem "api." (ex.: medstock.com.br).
DOMINIO=seudominio.com.br
# E-mail para avisos do Let's Encrypt sobre os certificados.
EMAIL_CERTIFICADO=seu_email@example.com

# Senha do Postgres. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=troque_esta_senha

# Chave do JWT, diferente da de desenvolvimento. Gere com: openssl rand -hex 32
SECRET_KEY=troque_esta_chave
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Limite de upload da API (MB) e do proxy (um pouco acima, com unidade).
UPLOAD_MAX_MB=50
LIMITE_UPLOAD_PROXY=60MB

# Super admin criado no primeiro start. Use uma senha forte e nova.
SUPER_ADMIN_EMAIL=admin@seudominio.com.br
SUPER_ADMIN_SENHA=troque_esta_senha

# Envio de e-mails (no Gmail, senha de app).
EMAIL_REMETENTE=seu_email_remetente@example.com
SENHA_EMAIL=sua_senha_de_app_do_email
